# Copy this file to .env and fill in values from https://my.telegram.org/apps.
# Never commit .env, session files, passwords, or API hashes.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram-session
TELEGRAM_SOURCE=
# Optional only for Telethon's first-time interactive authentication:
# TELEGRAM_PHONE=

# Paths are relative to this project unless absolute.
OUTPUT_DIRECTORY=downloads
SECTIONS_CONFIG=sections.json

MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_RETRIES=3
RETRY_DELAY=2
CHUNK_SIZE=524288
MIN_VIDEO_SIZE_MB=0
# Set to 0 for no upper limit.
MAX_FILE_SIZE_GB=0
DRY_RUN=false
